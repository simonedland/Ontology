# Copy to .env and change what you need. Everything is optional.

# Require "Authorization: Bearer <token>" on every API call (empty = no auth; fine on 127.0.0.1).
TGSTORE_TOKEN=

# Listen address for the API and PostgreSQL ports. 0.0.0.0 exposes them to your network: set a token
# and a database password first.
TGSTORE_BIND=127.0.0.1
TGSTORE_PORT=8080
TGSTORE_WORKERS=4
PG_PORT=5432

POSTGRES_USER=tgstore
POSTGRES_PASSWORD=tgstore
POSTGRES_DB=tgstore
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE=3GB
PG_SYNCHRONOUS_COMMIT=off

# Host folders mounted into the containers
TGSTORE_INBOX_DIR=./inbox
TGSTORE_SESSION_DIR=./session

# Telegram collector (https://my.telegram.org)
TG_API_ID=
TG_API_HASH=
