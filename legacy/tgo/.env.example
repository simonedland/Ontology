# Copy to .env (git-ignored) and edit. Every value is optional; the defaults are shown.
# Read by `docker compose` for interpolation only — not passed into containers wholesale.
# Pipeline settings (thresholds, weights, engine, exports ...) go in workspace/config/tgo.toml or
# workspace/config/tgo.env (TGO_<SECTION>_<FIELD>=value), not here.

# --- image -------------------------------------------------------------------------------------------
# TGO_IMAGE=tgo:local                 # tag to build/run; point at a registry image to skip building
# TGO_EXTRAS=scale                    # pip extras baked in: "" | scale | scale,docs,ids,image | all
# TGO_APT_PACKAGES=                   # extra Debian packages, e.g. "tesseract-ocr tesseract-ocr-eng"
# TGO_PIP_EXTRA=                      # extra pip requirements, e.g. "my-tgo-plugin==1.2"
# TGO_UID=1000                        # match your host user on Linux so bind-mounted outputs are yours
# TGO_GID=1000
# TGO_PROJECT=tgo                     # compose project name; change to run two stacks side by side

# --- folders (host side) ------------------------------------------------------------------------------
# TGO_DATA=./workspace/data           # inputs, mounted read-only at /data (collect writes here)
# TGO_OUT=./workspace/out             # outputs at /out
# TGO_CONFIG_DIR=./workspace/config   # /config: tgo.toml and tgo.env
# TGO_PLUGIN_DIR=./workspace/plugins  # /plugins (on PYTHONPATH)
# TGO_MODELS=./workspace/models       # /models: local ASR/OCR models, read-only
# TGO_SESSION_DIR=./workspace/session # Telethon session for `collect` (secret: keep it private)
# TGO_JDBC=./workspace/jdbc           # duckdb_jdbc-<ver>.jar for Ontop
# TGO_NEO4J_PLUGINS=./workspace/neo4j-plugins

# --- what to run ---------------------------------------------------------------------------------------
# TGO_INPUT=                          # sub-folder of /data for `pipeline` and `live`
# TGO_CASE=case                       # output sub-folder; also what neo4j/ontop serve (live uses "live")
# TGO_RUN_ARGS=                       # extra `tgo run` flags, e.g. "--engine duckdb --auto-accept 0.9"
# TGO_CONFIG=/config/tgo.toml         # used when the file exists
# TGO_PLUGINS=                        # comma-separated plugin modules, e.g. "watchlist_extractor,csv_exporter"
# TGO_DOMAIN=tgo.example.org          # IRI namespace host
# TGO_WHISPER_MODEL=                  # e.g. /models/whisper (dir with tokenizer.json) -> real ASR
# TGO_OCR_MODELS=                     # e.g. /models/ocr (RapidOCR .onnx files)       -> real OCR

# --- resources (containers hide their limits from os.cpu_count()/DuckDB, so size them here) -------------
# TGO_CPUS=4
# TGO_MEMORY=8g
# TGO_SCALE_WORKERS=3                 # ~ cpus - 1
# TGO_SCALE_THREADS=4                 # ~ cpus
# TGO_SCALE_MEMORY_LIMIT=5GB          # below TGO_MEMORY; leave ~0.4 GB per worker
# TGO_SCALE_EXPORTS=["parquet","neo4j"]   # add "ntriples" if you need it (slow, multi-GB at 10M+)

# --- servers (published on TGO_BIND only, through the proxy) -----------------------------------------
# TGO_BIND=127.0.0.1                  # do not widen without a reverse proxy / TLS in front
# TGO_PORT_VIEWER=8000
# TGO_PORT_LIVE=8765
# TGO_TOKEN=                          # live dashboard token; empty -> generated, see `docker compose logs live`
# TGO_INTERVAL=5                      # live: seconds between scans of the input folder
# NEO4J_PASSWORD=                     # required for the neo4j profile (>= 8 chars)
# NEO4J_PAGECACHE=4G
# NEO4J_HEAP=4G
# NEO4J_HTTP_PORT=7474
# NEO4J_BOLT_PORT=7687
# ONTOP_PORT=8080
# TGO_PROXY_ROUTES=8000=viewer:8000,8765=live:8765,7474=neo4j:7474,7687=neo4j:7687,8080=ontop:8080

# --- live collection (the only online step; needs a lawful basis) ----------------------------------------
# TG_API_ID=
# TG_API_HASH=
